{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=irmadulce.db"
  },
  "Jwt": {
    "Key": "IrmaDulce-SecretKey-Dev-2026-SuperSegura-256bits!",
    "Issuer": "IrmaDulce.API",
    "Audience": "IrmaDulce.Client",
    "ExpirationMinutes": 480
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/irma-dulce-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}